(logger) {
	log {
		output file /var/log/caddy/{args[0]}-access.log
		level INFO
	}
	log {
		output file /var/log/caddy/{args[0]}-error.log
		level ERROR
	}
}

(tls_cf) {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}
}

(base_config) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	handle_errors {
		root * /var/www/errors
		rewrite * /{err.status_code}.html
		try_files {path} /generic.html
		templates
		file_server
	}
}

(tailnet_app) {
	{args[0]}.ipn.netherspark.net {
		import logger {args[0]}
		import tls_cf
		import base_config
		
		@not_tailnet {
			not client_ip 100.64.0.0/10
		}
		respond @not_tailnet "Access denied" 403
		
		reverse_proxy http://{args[1]} {
			health_uri {args[2]}
			health_interval 10s
		}
	}
}

(public_app) {
	{args[0]} {
		import logger {args[1]}
		import base_config
		reverse_proxy {args[2]} {
			health_uri {args[3]}
			health_interval 10s
		}
	}
}

# --- Tailnet-only services ---

import tailnet_app sonarr sonarr:8989 /ping
import tailnet_app radarr radarr:7878 /ping
import tailnet_app sabnzbd sabnzbd:8080 /
import tailnet_app bazarr bazarr:6767 /ping

# --- Public sites ---

import public_app play.beans.is jellyfin jellyfin:8096 /health
import public_app invites.play.beans.is wizarr wizarr:5690 /
import public_app request.play.beans.is seer seerr:5055 /api/v1/status

hdhr.beans.is {
	import logger hdhr
	import tls_cf
	import base_config
	reverse_proxy http://dispatcharr:9191 {
		health_uri /
		health_interval 10s
	}
}
